# ============================================
# EduLogic - .gitignore
# ============================================

# --- Entornos y secretos (NUNCA subir credenciales) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python / Backend ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- Node / Frontend (Tailwind CLI, herramientas) ---
node_modules/

# CSS compilado: es un artefacto generado, no codigo fuente.
# Se genera localmente con `npm run dev` y en el despliegue con `npm run build`.
frontend/css/estilos.css

# --- Editores e IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Sistema operativo ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Archivos temporales y logs ---
*.log
*.tmp
tmp/
temp/
